# SOAR Deployment Sudoers Configuration
#
# This file grants the 'soar' user the necessary sudo privileges for automated deployment
# via CI/CD pipelines. All deployment operations are handled by a single deployment script
# to minimize the attack surface and simplify security auditing.
#
# Installation:
#   sudo cp infrastructure/sudoers.d/soar /etc/sudoers.d/soar
#   sudo chmod 440 /etc/sudoers.d/soar
#   sudo visudo -c  # Verify syntax
#
#   sudo cp infrastructure/soar-deploy /usr/local/bin/soar-deploy
#   sudo chmod 755 /usr/local/bin/soar-deploy
#   sudo chown root:root /usr/local/bin/soar-deploy
#
# Security: This grants minimal privileges - only the deployment script and
# the install command (for bootstrapping soar-deploy itself) can be run with sudo

# Allow soar user to bootstrap the deployment script from a deploy package
soar ALL=(root) NOPASSWD: /usr/bin/install -m 755 /tmp/soar/deploy/*/soar-deploy /usr/local/bin/soar-deploy

# Allow soar user to execute the deployment script for production (default)
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy /tmp/soar/deploy/*

# Allow soar user to execute the deployment script with environment argument
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy staging /tmp/soar/deploy/*
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy production /tmp/soar/deploy/*
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy radar /tmp/soar/deploy/*
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy radar-staging /tmp/soar/deploy/*
soar ALL=(root) NOPASSWD: /usr/local/bin/soar-deploy radar-production /tmp/soar/deploy/*

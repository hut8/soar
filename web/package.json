{
	"name": "web",
	"private": true,
	"version": "0.0.0-git",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/generate-version.js",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && oxlint .",
		"test:e2e": "playwright test",
		"test": "bun run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sentry/vite-plugin": "^5.1.1",
		"@skeletonlabs/skeleton-svelte": "^4.12.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/postcss": "^4.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/google.maps": "^3.58.1",
		"@types/plotly.js": "^3.0.10",
		"oxlint": "^1.51.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"rollup-plugin-external-globals": "^0.13.0",
		"svelte": "^5.53.8",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-static-copy": "^4.0.0"
	},
	"dependencies": {
		"@deck.gl/core": "^9.2.11",
		"@deck.gl/geo-layers": "^9.2.11",
		"@deck.gl/mapbox": "^9.2.11",
		"@googlemaps/js-api-loader": "^2.0.2",
		"@logtape/logtape": "^2.0.4",
		"@lucide/svelte": "^0.577.0",
		"@sentry/sveltekit": "^10.42.0",
		"@skeletonlabs/skeleton": "^4.12.1",
		"@skeletonlabs/tw-plugin": "^0.4.1",
		"autoprefixer": "^10.4.27",
		"cesium": "^1.139.1",
		"country-flag-icons": "^1.6.15",
		"dayjs": "^1.11.19",
		"maplibre-gl": "^5.19.0",
		"plotly.js-dist-min": "^3.4.0"
	}
}
